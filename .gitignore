# Abhängigkeiten und Build-Ergebnis
node_modules/
plugin/main.js
plugin/*.js.map
plugin/tests/build/

# Obsidian-Zustand des Test-Vaults (Layout, Cache, Plugin-Daten)
# community-plugins.json gehört dazu: Obsidian schreibt die Datei beim Start leer,
# wenn plugin/main.js noch nicht gebaut ist — eingecheckt würde das die Aktivierung
# reihum auf allen Rechnern ausknipsen.
Speaker Management System Test Vault/.obsidian/community-plugins.json
Speaker Management System Test Vault/.obsidian/workspace.json
Speaker Management System Test Vault/.obsidian/workspace-mobile.json
Speaker Management System Test Vault/.obsidian/cache/
Speaker Management System Test Vault/.obsidian/plugins/*/data.json
Speaker Management System Test Vault/.trash/

# Claudian-Sitzungen: Gesprächsverläufe aus dem Vault, nichts fürs Repo
Speaker Management System Test Vault/.claudian/

# macOS
.DS_Store
