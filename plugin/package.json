{
  "name": "speaker-management-system",
  "version": "0.20.0",
  "description": "Obsidian-Plugin für das Content Management von Konferenzen.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "node esbuild.tests.mjs && node --test \"tests/build/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
